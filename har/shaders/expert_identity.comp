#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer ExpertBytes {
    uint words[];
} expert;

layout(set = 0, binding = 1, std430) writeonly buffer IdentityBytes {
    uint words[];
} identity;

layout(push_constant) uniform Params {
    uint word_count;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < params.word_count) {
        identity.words[index] = expert.words[index];
    }
}
