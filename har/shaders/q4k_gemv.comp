#version 450

// One workgroup per output row.  The input is an FP32 activation vector and
// weights use the canonical 144-byte GGML Q4_K super-block layout.  The
// layout is described here rather than exposing ggml objects to HAR callers.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QuantizedWeights {
    uint weight_words[];
};
layout(set = 0, binding = 1, std430) readonly buffer Activations {
    float input_values[];
};
layout(set = 0, binding = 2, std430) buffer Output {
    float output_values[];
};
layout(push_constant) uniform Params {
    uint rows;
    uint blocks_per_row;
} params;

shared float partial[256];

uint byte_at(uint base, uint byte_offset) {
    uint word = weight_words[(base + byte_offset) >> 2u];
    return (word >> (((base + byte_offset) & 3u) * 8u)) & 0xffu;
}

float half_at(uint base, uint byte_offset) {
    uint word = weight_words[(base + byte_offset) >> 2u];
    vec2 values = unpackHalf2x16(word);
    return ((byte_offset & 2u) == 0u) ? values.x : values.y;
}

uint scale_at(uint base, uint index) {
    if (index < 4u) return byte_at(base, 4u + index) & 63u;
    return (byte_at(base, 4u + index + 4u) & 15u) |
           ((byte_at(base, 4u + index - 4u) >> 6u) << 4u);
}

uint min_at(uint base, uint index) {
    if (index < 4u) return byte_at(base, 4u + index + 4u) & 63u;
    return (byte_at(base, 4u + index + 4u) >> 4u) |
           ((byte_at(base, 4u + index) >> 6u) << 4u);
}

float dequant_value(uint base, uint index) {
    uint group = index / 32u;
    uint lane_in_64 = index & 63u;
    uint q_byte = byte_at(base, 16u + (index / 64u) * 32u + (lane_in_64 & 31u));
    uint q = (lane_in_64 < 32u) ? (q_byte & 15u) : (q_byte >> 4u);
    float d = half_at(base, 0u) * float(scale_at(base, group));
    float dm = half_at(base, 2u) * float(min_at(base, group));
    return d * float(q) - dm;
}

void main() {
    uint lane = gl_LocalInvocationIndex;
    uint row = gl_WorkGroupID.x;
    float sum = 0.0;
    if (row < params.rows) {
        for (uint block = 0u; block < params.blocks_per_row; ++block) {
            uint base = (row * params.blocks_per_row + block) * 144u;
            uint index = lane;
            sum += dequant_value(base, index) * input_values[block * 256u + index];
        }
    }
    partial[lane] = sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane == 0u && row < params.rows) output_values[row] = partial[0];
}
